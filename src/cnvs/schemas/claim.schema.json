{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qhdalabs.example/cnvs/schemas/claim.schema.json",
  "title": "CNVS Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claim_id", "event_id", "subject", "predicate",
    "object", "claim_type", "attribution", "modality", "source_id",
    "publication_time", "supporting_evidence_ids", "contradicting_evidence_ids",
    "status", "confidence"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "claim_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "object": { "type": "string", "minLength": 1 },
    "claim_type": { "type": "string", "minLength": 1 },
    "attribution": { "type": ["string", "null"] },
    "modality": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "publication_time": { "type": ["string", "null"], "format": "date-time" },
    "supporting_evidence_ids": {
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "contradicting_evidence_ids": {
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "status": {
      "enum": [
        "UNVERIFIED", "PARTIALLY_SUPPORTED", "SUPPORTED", "CONTRADICTED",
        "DISPUTED", "WITHDRAWN"
      ]
    },
    "confidence": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] }
  }
}
